# 001 ERP — environment config (copy to .env)

APP_NAME=001 ERP

# Dev defaults to local SQLite for instant run.
# PRODUCTION = PostgreSQL (required for 30 concurrent users + pgvector RAG):
#   DATABASE_URL=postgresql+psycopg2://erp:erp@127.0.0.1:5432/erp_001
DATABASE_URL=sqlite:///./dev.db

# Session signing key — CHANGE in production
SECRET_KEY=dev-secret-change-me

# Server
HOST=127.0.0.1
PORT=8001

# Require HTTPS / secure cookies (true in production)
SECURE_COOKIES=false

# Local AI (Phase 2) — Ollama runtime + models (swappable per deployment).
#   install: ollama pull qwen2.5:14b && ollama pull bge-m3 && ollama pull qwen2.5vl:7b
# 14b is the default so chat + vision + embed (~17GB) all fit one 24GB GPU at once.
# 32b has better tool discipline but needs ≥40GB VRAM for the full stack — see
# docs/AI-OPS.md. Verify the stack with: python scripts/preflight_ai.py
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen2.5vl:7b
